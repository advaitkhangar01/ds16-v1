# --- DS16 PRODUCTION ENVIRONMENT ---
NODE_ENV=production
PORT=3001

# PostgreSQL on VPS (replace with actual credentials)
# Example: postgresql://ds16user:yourpassword@localhost:5432/ds16
DATABASE_URL=your_vps_db_url

# Use a strong, random string (e.g., openssl rand -base64 32)
JWT_SECRET=strong_random_secret

# Comma-separated list of allowed origins (e.g., https://yourdomain.com)
ALLOWED_ORIGINS=https://crm.designstudio16.co.in
